# Normalize line endings
* text=auto eol=lf

# Swift / Objective-C
*.swift   text eol=lf diff=swift
*.h       text eol=lf
*.m       text eol=lf
*.mm      text eol=lf

# Xcode artifacts
*.pbxproj         merge=union eol=lf
*.xcscheme        text eol=lf
*.xcconfig        text eol=lf
*.entitlements    text eol=lf
*.plist           text eol=lf
*.storekit        text eol=lf
*.xcprivacy       text eol=lf

# Localization (Xcode emits LF; never let Windows clients rewrite to CRLF)
*.xcstrings       text eol=lf
*.strings         text eol=lf
*.stringsdict     text eol=lf

# RN / JS / TS
*.ts              text eol=lf
*.tsx             text eol=lf
*.js              text eol=lf
*.jsx             text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.sh              text eol=lf

# Binary
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.pdf             binary
*.zip             binary
*.ipa             binary
*.app             binary
*.ttf             binary
*.otf             binary
*.woff            binary
*.woff2           binary
*.mp3             binary
*.m4a             binary
*.caf             binary
*.mp4             binary
*.mov             binary

# SVG: treat as text so diffs work
*.svg             text eol=lf
