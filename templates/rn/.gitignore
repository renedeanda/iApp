# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native signing credentials (never commit these)
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest
*.provisionprofile

# Xcode build artifacts (ios/ and android/ themselves ARE tracked for native widget code)
ios/build/
ios/Pods/
android/app/build/
android/build/
android/.gradle/

# CocoaPods lockfile (regenerated by pod install)
ios/Podfile.lock

# metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# jest
coverage/
