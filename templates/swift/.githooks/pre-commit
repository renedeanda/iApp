#!/usr/bin/env bash
#
# Pre-commit hook.
# Activate once per checkout:
#   git config core.hooksPath .githooks
#
# Steps (silent on success, loud on failure):
# 1. Regenerate project.yml -> .xcodeproj so drift never ships.
# 2. SwiftFormat in lint mode (no edits — commit is the user's intent).
# 3. SwiftLint in quiet mode.
#
# Skip via `git commit --no-verify` ONLY when the user has a hard
# reason (e.g., docs-only commits don't need xcodegen). Never skip
# in CI.

set -euo pipefail

if command -v xcodegen >/dev/null 2>&1; then
  if [ -f "project.yml" ]; then
    xcodegen generate >/dev/null
  fi
fi

if command -v swiftformat >/dev/null 2>&1; then
  swiftformat --lint . 2>/dev/null
fi

if command -v swiftlint >/dev/null 2>&1; then
  swiftlint --quiet
fi
