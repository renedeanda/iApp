    "settings.deleteAllData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Data"
          }
        }
      }
    },
    "settings.deleteAllData.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently removes only this app's data saved on this device and in iCloud."
          }
        }
      }
    },
    "settings.deleteAllData.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete app data?"
          }
        }
      }
    },
    "settings.deleteAllData.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Only app-owned data saved by this app will be deleted from this device and iCloud where available. It will not delete Photos, Contacts, Files outside this app, or other apps' data."
          }
        }
      }
    },
    "settings.deleteAllData.confirm.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete App Data"
          }
        }
      }
    },
    "settings.deleteAllData.result.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Data"
          }
        }
      }
    },
    "settings.deleteAllData.success": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All app data has been deleted."
          }
        }
      }
    },
    "settings.deleteAllData.pendingCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local data was deleted. iCloud deletion will retry before sync resumes."
          }
        }
      }
    },
    "settings.data.manage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data & Backup"
          }
        }
      }
    },
    "settings.data.manage.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion controls for app-owned data."
          }
        }
      }
    },
    "settings.deleteAllData.noAccount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data on this device was deleted. iCloud isn't reachable right now — to remove iCloud data too, sign in to iCloud and delete again."
          }
        }
      }
    },
    "settings.deleteAllData.error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion didn't finish — some data may remain. Please try again."
          }
        }
      }
    },
