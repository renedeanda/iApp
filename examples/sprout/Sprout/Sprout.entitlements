<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Default entitlements for the Sprout template.

  The wizard graduates commented blocks above the divider when a
  feature is enabled in DECISIONS/004-native-feature-checklist.md.
  Never enable an entitlement without the matching ADR row.

  Currently active: App Groups + CloudKit container (the minimum
  needed for shared defaults + iCloud sync).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.sprout</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.example.sprout</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>

	<!-- DIVIDER — wizard graduates these when enabled -->

	<!-- Push notifications (wizard enables for NotificationService) -->
	<!--
	<key>aps-environment</key>
	<string>development</string>
	-->

	<!-- Siri / Intents (wizard enables when App Intents target added) -->
	<!--
	<key>com.apple.developer.siri</key>
	<true/>
	-->

	<!-- Time Sensitive Notifications (rare; wizard prompts) -->
	<!--
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	-->

	<!-- Sign in with Apple (wizard enables when auth flow needed) -->
	<!--
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	-->

	<!-- Family Controls (rare; wizard prompts) -->
	<!--
	<key>com.apple.developer.family-controls</key>
	<true/>
	-->
</dict>
</plist>
