<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS / Mac Catalyst entitlements for the Sprout template.

  Only used when wizard enables Universal Purchase (Mac Catalyst opt-in)
  per DECISIONS/001-tech-choice.md "Universal Purchase: yes" flag.

  Sandbox is mandatory for Mac App Store. user-selected-files RO is
  the minimum that lets the app open the user's documents on demand
  without requesting broad disk access.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.sprout</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.example.sprout</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
