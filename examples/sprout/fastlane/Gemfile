# Fastlane dependency pin for the Sprout template.
#
# Commented-by-default scaffolding (per docs/HOUSEKEEPING.md): the
# fastlane lanes don't run until you've done your first manual
# TestFlight upload and uncommented the lanes in Fastfile.
#
# First-time setup:
#   cd templates/swift   # (or the renamed child app root)
#   bundle install       # generates Gemfile.lock — commit it after
#
# Gemfile.lock is intentionally NOT shipped — it's generated on the
# first `bundle install` and committed then, so the pin reflects the
# resolving machine's platform.

source "https://rubygems.org"

gem "fastlane", "~> 2.220"
